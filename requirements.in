# Generate requirements.txt with:
# pip-compile --unsafe-package pip --unsafe-package setuptools --unsafe-package xattr -U -r > requirements.txt
coverage
django == 5.2.*
djangorestframework
flake8
jinja2
markupsafe
mistune
mysqlclient
numpy >= 1.26
pdfkit
pillow >= 10.1
pip-tools
pyparsing
# Floor, not a pin: pytest through 9.0.2 relies on predictable
# /tmp/pytest-of-<user> directory permissions (CVE-2025-71176), fixed in 9.0.3.
# Stating the security requirement here is what stops a later regeneration
# dropping below it: pip-compile takes the newest release the index offers, so
# an index mirror or cache without the newer ones would resolve 9.0.2 silently.
pytest >= 9.0.3
pytest-cov
pytest-django
pytz
pyyaml >= 6.0.1
qrcode
regex
requests
rms-julian
rms-pdsfile >= 0.0.18
rms-pdslogger
rms-pdstable
rms-translator