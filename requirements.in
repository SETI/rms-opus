# Generate requirements.txt with:
# pip-compile --unsafe-package pip --unsafe-package setuptools --unsafe-package xattr -U -r > requirements.txt
coverage
django == 5.2.*
djangorestframework
flake8
jinja2
markupsafe
mysqlclient
numpy >= 1.26
pdfkit
pillow >= 10.1
pip-tools
pyparsing
# Floor, not a pin: pytest through 9.0.2 relies on predictable
# /tmp/pytest-of-<user> directory permissions (CVE-2025-71176), fixed in 9.0.3.
# What the floor buys is a loud failure instead of a quiet one: pip-compile takes
# the newest release an index offers, so against a mirror or cache that can see
# only vulnerable versions a bare `pytest` resolves one and says nothing, while
# this constraint leaves no candidate and errors. That is reasoning about what a
# constraint does, not a resolve anyone has run here.
pytest >= 9.0.3
pytest-cov
pytest-django
pytz
pyyaml >= 6.0.1
qrcode
regex
requests
rms-julian
rms-pdsfile >= 0.0.18
rms-pdslogger
rms-pdstable
rms-translator