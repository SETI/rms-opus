*.pyc
__pycache__
.DS_Store
._*
*~*
*.bak
*.*.bak
temp*.*
# ...which would otherwise swallow this module, whose name begins "temp".
!src/opus_config/template.py
*.marks
*.wsgi
*.log
logs
log.txt
nohup.out

*venv*
!scripts/*
test_out*
coverage_out*
opus.toml
opus.toml.tmp
# The deploy chain's own configuration, holding a database password and the Django
# secret key. scripts/server/deploy.env.template is the checked-in contract for it.
scripts/server/secrets/

migrations/

.coverage
# The parallel data files the pipeline's subprocesses write during the import suite,
# which pytest-cov combines into .coverage at the end of the run.
.coverage.*
coverage.xml
# The per-function report the import suite's executed-functions check reads.
coverage.json
coverage_report.txt
htmlcov/
# Written by the profiling recipe in integration_tests/test_api/TEST_API_README.md
profile.out


# Packaging (setuptools-scm writes the version file at build time)
build/
dist/
*.egg-info/
src/opus_config/_version.py
# Agent isolation worktrees (created by Claude Code; never part of the tree)
.claude/worktrees/

# Sphinx: the build output, and the pages docs/_ext/ writes before each build.
docs/_build/
docs/api_reference.rst
docs/api_opus_*.rst
docs/api_guide_fields_table.rst
