# The mini-holdings fixture is real archive content, and its PDS3 tables are
# fixed-length records terminated by CRLF -- the label's RECORD_BYTES counts both
# bytes. Git must not touch a line ending in there: a checkout or a commit under
# core.autocrlf on a Windows machine would change every record's length, and every
# table would then be parsed one byte short per row with no error anywhere. -text
# turns end-of-line conversion off for the whole fixture, whatever the developer's
# configuration says.
tests/fixtures/mini_holdings/** -text

# The goldens are this repository's own text, written and read by one serializer with
# \n line endings, so they follow the repository's normal rules and are marked text so
# a diff of one shows rows.
import_tests/goldens/*.tsv text eol=lf
