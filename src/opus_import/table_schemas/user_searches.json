[
    {
        "field_name": "id",
        "field_type": "uint4",
        "field_autoincrement": true,
        "field_key": "primary",
        "field_notnull": true
    },
    {
        "field_name": "search_hash",
        "field_type": "binary32",
        "field_key": "unique",
        "field_notnull": true,
        "comment": "The SHA-256 of the search's selections, query types, units and order."
    },
    {
        "field_name": "result_count",
        "field_type": "uint4",
        "field_default": null,
        "comment": "The rows the search's build wrote to search_results; NULL until it is built."
    },
    {
        "field_name": "results_built_at",
        "field_type": "datetime",
        "field_default": null,
        "comment": "When the search's results were built; NULL until they are."
    },
    {
        "field_name": "last_used_at",
        "field_type": "datetime",
        "field_notnull": true,
        "comment": "When the search was registered or last used, stamped at most once a day."
    }
]
