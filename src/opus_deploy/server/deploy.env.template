################################################################################
# Deploy infrastructure configuration for one OPUS server.
#
# This is NOT the application's configuration. The two are deliberately separate:
#
#   deploy.env  is read by the scripts beside this file, before any OPUS code
#               exists on the machine. It says where to install, which account to
#               run as, which database credentials to use, and where the PDS
#               holdings are.
#   opus.toml   is read by the installed application and the import pipeline at
#               run time. import_and_deploy/_write_opus_toml.sh generates it from
#               the values below, one per installation, and the deploy exports
#               OPUS_CONFIG pointing at it.
#
# Install it by copying this file, from the directory opus_deploy_scripts wrote
# these scripts into, and filling in every <PLACEHOLDER>:
#
#     cd <that directory>
#     install -d -m 700 secrets
#     install -m 600 deploy.env.template secrets/deploy.env
#
# `install -d -m 700` rather than `mkdir -p`: mkdir applies the caller's umask, so
# under a permissive one the directory is created world-writable and another local
# account can replace deploy.env -- which this chain reads with `source`, i.e. runs as
# shell code with the deploy user's privileges.
#
# It holds a database password and a Django secret key, so it must be readable by the
# deploy account and by nobody else, which is what those two modes are for. Updating
# these scripts never writes into secrets/.
#
# It is read with `source`, so it is shell syntax: VAR=value, no spaces around the
# `=`, and quote any value containing a space. Every variable below is required
# except where it says otherwise -- _read_deploy_env.sh refuses to continue if one is
# missing or empty, and a value containing a newline or a tab is refused by
# _write_opus_toml.sh, because TOML cannot represent one inside a quoted value.
################################################################################

# The installation root: any directory the account named by OPUS_USER below owns.
# The User Guide uses /opt/opus, and nothing here assumes that or any other path.
# The deploy chain expects, or creates, these underneath it:
#   $OPUS_DIR/staged/         one directory per installation built: its virtualenv,
#                             its opus.toml and its wsgi.py symlink
#   $OPUS_DIR/deployed        a symlink to the installation being served, which is
#                             the path Apache's vhost points into
#   $OPUS_DIR/import          a symlink to the installation running an import
#   $OPUS_DIR/opus_logs/      the web application's log
#   $OPUS_DIR/import_logs/    one directory per import run
#   $OPUS_DIR/downloads/      zipped cart files
#   $OPUS_DIR/manifests/      their manifests
#   $OPUS_DIR/static_media/   where collectstatic gathers the static files
OPUS_DIR='<OPUS_DIR>'

# The virtual environment the deploy chain's own commands come from: the one
# `opus_deploy_scripts` was run out of to write these scripts. Every script here
# activates it for itself, so none of them depends on what the operator's shell
# happened to have active, and cron and nohup can run them.
#
# It is NOT one of the installations under $OPUS_DIR/staged. Those are built by the
# deploy and replaced by it; this one holds the release whose deploy chain is in this
# directory, and update_deploy_scripts.sh is what moves it forward.
OPUS_DEPLOY_VENV='<OPUS_DEPLOY_VENV>'

# The Python each installation's virtualenv is built with, as a command on PATH.
# Leave it as it ships unless this server offers a later Python and not that one:
# `python3` is whatever the machine calls its system Python, which may be older than
# OPUS supports, so the interpreter is named here rather than assumed.
OPUS_PYTHON='python3.12'

# The Unix account OPUS runs as: the one the web server's workers run as, and the one
# every script here has to be run as. Everything a deploy creates -- the installation,
# its virtualenv, and the opus.toml it writes at mode 0600 -- belongs to whoever ran
# the deploy, so a deploy run as anyone else (root, most easily) builds an
# installation the web server cannot read. _read_deploy_env.sh refuses rather than
# letting that reach the switch.
OPUS_USER='<OPUS_USER>'

# The MySQL server the import pipeline and the web application connect to, usually
# localhost. It is what the generated opus.toml names.
OPUS_DB_HOST='<OPUS_DB_HOST>'

# The MySQL user the import pipeline and the web application connect as. This user
# needs most privileges, including creating and dropping tables.
OPUS_DB_USER='<OPUS_DB_USER>'
OPUS_DB_PASSWORD='<OPUS_DB_PASSWORD>'

# Django's secret key: a unique, secret string for this server. Generator tools are
# available: https://www.google.com/search?q=django+secret+generator
OPUS_SECRET_KEY='<OPUS_SECRET_KEY>'

# The roots of the PDS3 and PDS4 holdings trees. $PDS3_HOLDINGS_DIR/volumes and
# $PDS4_HOLDINGS_DIR/bundles must both exist; the deploy checks.
PDS3_HOLDINGS_DIR='<PDS3_HOLDINGS_DIR>'
PDS4_HOLDINGS_DIR='<PDS4_HOLDINGS_DIR>'

# The file holding the date of the last blog update, and the file holding the HTML
# of any short-term notification the web application displays.
LAST_BLOG_UPDATE_FILE='<LAST_BLOG_UPDATE_FILE>'
NOTIFICATION_FILE='<NOTIFICATION_FILE>'


################################################################################
# The application's own settings. Each one is written into the opus.toml the deploy
# generates, and nothing in the scripts assumes a value for any of them.
################################################################################

# Django's DEBUG. It has to be `true` or `false`, unquoted TOML, and it is `false`
# on any server reachable from outside the machine it runs on. A staging server is
# the case for `true`.
OPUS_DEBUG='false'

# The host names and addresses this installation answers to, separated by spaces.
# Django refuses a request whose Host header is not among them, so every name a
# browser, a proxy or a health check reaches it by belongs here -- including
# 127.0.0.1 and localhost, which is how a smoke test from the server itself reaches
# it.
OPUS_ALLOWED_HOSTS='127.0.0.1 localhost <THE PUBLIC HOST NAME>'

# The prefix on every key this installation puts in the shared cache. Two
# installations sharing one memcached need different prefixes, or each will read the
# other's answers.
OPUS_CACHE_PREFIX='<OPUS_CACHE_PREFIX>'


################################################################################
# The two services the switch at the end of a deploy stops, restarts and starts.
# Both have defaults, so leave them as they ship unless this server differs.
################################################################################

# The systemd unit running the application's workers. It is stopped for the switch
# and started again after it, and that is the only moment a deploy interrupts the
# site. Apache with mod_wsgi is 'apache2' on Debian and Ubuntu and 'httpd' on Red
# Hat; a gunicorn or uWSGI unit behind nginx is whatever that unit is called.
OPUS_WEB_SERVICE='apache2'

# The systemd unit holding the shared cache, restarted after the switch to empty it:
# it holds results computed against the database being replaced, and a cache key does
# not say which release wrote it. Leave this empty if there is no shared cache -- the
# per-worker one goes with the workers anyway.
OPUS_CACHE_SERVICE='memcached'

# The public URL of this installation, and where it serves things from. All four end
# with a slash, and all four appear in what the API returns, so they are the URLs a
# user's browser has to be able to reach -- not the internal ones.
OPUS_PUBLIC_URL='<OPUS_PUBLIC_URL>'
OPUS_PRODUCT_HTTP_PATH='<OPUS_PRODUCT_HTTP_PATH>'
OPUS_VIEWMASTER_URL='<OPUS_VIEWMASTER_URL>'
OPUS_TAR_FILE_URL='<OPUS_TAR_FILE_URL>'


################################################################################
# Copying a finished database to a second server. Both of these are used only by
# run_full_opus_import.sh, at the end of an import.
################################################################################

# Where mysqldump writes, and where the load reads from. On two servers that copy
# databases to each other, this is a directory both can see.
OPUS_DB_DUMP_DIR='<OPUS_DB_DUMP_DIR>'

# The MySQL server the finished database is copied to, or empty for none. With a
# host here, an import ends by dumping what it built and loading it there, so that
# two servers can serve the same database. With this empty, the import stops when
# the database is built, which is what a single server wants.
OPUS_PEER_DB_HOST=''

# Where to mail the log when an import finishes, or empty for nowhere. An import runs
# for hours or days under nohup, so the mail is how anyone finds out it ended, and
# whether it ended well. With this empty the log is left where it was written and
# nothing is sent.
OPUS_IMPORT_MAIL_TO=''
