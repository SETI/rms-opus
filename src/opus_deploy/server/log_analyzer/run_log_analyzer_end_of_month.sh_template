#!/bin/bash
source <VENV>/bin/activate
rm -rf /tmp/log_analyzer_results_temp_eom
mkdir /tmp/log_analyzer_results_temp_eom
opus_log_analyzer --cronjob --cronjob-date -1 --html --dns -o "/tmp/log_analyzer_results_temp_eom/%Y/OPUS-log-analysis-%Y-%m.html" "<APACHELOGDIR>/<PREFIX>_access_log-%Y-%m-%d"
cp -r /tmp/log_analyzer_results_temp_eom/* <WWW>/log_analyzer_results
rm -rf /tmp/log_analyzer_results_temp_eom
