PDS_VERSION_ID        = PDS3

RECORD_TYPE           = FIXED_LENGTH
RECORD_BYTES          = 404
FILE_RECORDS          = 15

^INDEX_TABLE          = "NHPCMV_1001_index.tab"

DATA_SET_ID           = "NH-X-MVIC-2-PLUTOCRUISE-V1.0"
VOLUME_ID             = NHPCMV_1001
INSTRUMENT_HOST_NAME  = "NEW HORIZONS"
INSTRUMENT_ID         = "MVIC"
TARGET_NAME           = "N/A"
PRODUCT_CREATION_TIME = 2025-06-06T20:38:50
START_TIME            = 2007-09-18T22:10:56.579
STOP_TIME             = 2014-07-23T17:23:12.265

OBJECT     = INDEX_TABLE
  INTERCHANGE_FORMAT = ASCII
  INDEX_TYPE         = "SINGLE"
  ROWS               = 15
  ROW_BYTES          = 404
  COLUMNS            = 15
  DESCRIPTION        = "This index table provides an entry for each
    data product on this volume."

  OBJECT     = COLUMN
    COLUMN_NUMBER = 1
    NAME = VOLUME_ID
    START_BYTE = 2
    BYTES = 11
    DATA_TYPE = CHARACTER
    FORMAT = "A11"
    DESCRIPTION = "This parameter identifies the archive volume."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 2
    NAME = FILE_SPECIFICATION_NAME
    START_BYTE = 16
    BYTES = 52
    DATA_TYPE = CHARACTER
    FORMAT = A52
    DESCRIPTION = "This parameter provides the full path to the data file."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 3
    NAME = DATA_SET_ID
    START_BYTE = 71
    BYTES = 43
    DATA_TYPE = CHARACTER
    FORMAT = "A43"
    DESCRIPTION = "This parameter provides the PDS data set id."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 4
    NAME = PRODUCT_ID
    START_BYTE = 117
    BYTES = 27
    DATA_TYPE = CHARACTER
    FORMAT = "A27"
    DESCRIPTION = "This parameter provides the PDS unique identifier assigned
to the data product."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 5
    NAME = PRODUCT_CREATION_TIME
    START_BYTE = 147
    BYTES = 19
    DATA_TYPE = DATE
    FORMAT = "A19"
    DESCRIPTION = "This parameter provides the date the data label was
created."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 6
    NAME = REDUCTION_LEVEL
    START_BYTE = 169
    BYTES = 10
    DATA_TYPE = CHARACTER
    FORMAT = "A10"
    DESCRIPTION = "This parameter provides the level of data
      reduction:

        LEVEL1  = Raw data

        LEVEL2  = Calibrated/Reduced data in engineering units
                  appropriate for the instrument.
      "
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 7
    NAME = SPACECRAFT_CLOCK_START_COUNT
    START_BYTE = 182
    BYTES = 18
    DATA_TYPE = CHARACTER
    FORMAT = "A18"
    DESCRIPTION = "This parameter provides the spacecraft clock value at the
start of the observation, at the spacecraft for spacecraft data, or it is set
to N/A for Deep Space Network Tracking and Navigation Files (DSN TNFs)."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 8
    NAME = SPACECRAFT_CLOCK_STOP_COUNT
    START_BYTE = 203
    BYTES = 18
    DATA_TYPE = CHARACTER
    FORMAT = "A18"
    DESCRIPTION = "This parameter provides the spacecraft clock value at the
end of the observation, at the spacecraft for spacecraft data, or it is set to
N/A for Deep Space Network Tracking and Navigation Files (DSN TNFs)."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 9
    NAME = START_TIME
    START_BYTE = 224
    BYTES = 23
    DATA_TYPE = TIME
    FORMAT = "A23"
    DESCRIPTION = "This parameter provides the UTC value at the start of the
observation at the spacecraft for spacecraft data, or on the earth for Deep
Space Network Tracking and Navigation Files (DSN TNFs)."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 10
    NAME = STOP_TIME
    START_BYTE = 250
    BYTES = 23
    DATA_TYPE = TIME
    FORMAT = "A23"
    DESCRIPTION = "This parameter provides the UTC value at the end of the
observation at the spacecraft for spacecraft data, or on the earth for Deep
Space Network Tracking and Navigation Files (DSN TNFs)."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 11
    NAME = TARGET_NAME
    START_BYTE = 276
    BYTES = 28
    DATA_TYPE = CHARACTER
    FORMAT = "A28"
    DESCRIPTION = "This parameter identifies the target, defined as the
active central body in the Guidance and Control System at the time of the
observation."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 12
    NAME = INSTRUMENT_HOST
    START_BYTE = 307
    BYTES = 12
    DATA_TYPE = CHARACTER
    FORMAT = "A12"
    DESCRIPTION = "This parameter identifies the spacecraft."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 13
    NAME = INSTRUMENT_ID
    START_BYTE = 322
    BYTES = 6
    DATA_TYPE = CHARACTER
    FORMAT = "A6"
    DESCRIPTION = "This parameter identifies the instrument."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 14
    NAME = INSTRUMENT_NAME
    START_BYTE = 331
    BYTES = 61
    DATA_TYPE = CHARACTER
    FORMAT = "A61"
    DESCRIPTION = "This parameter identifies the instrument."
  END_OBJECT = COLUMN

  OBJECT     = COLUMN
    COLUMN_NUMBER = 15
    NAME = TELEMETRY_APPLICATION_ID
    START_BYTE = 395
    BYTES = 7
    DATA_TYPE = CHARACTER
    FORMAT = "A7"
    DESCRIPTION = "This parameter identifies the application identifier (ApID)
in the telemetry packets used to create the data product.  The ApID format
uses here is 0xXXX, where XXX are hexadecimal digits"
  END_OBJECT = COLUMN

END_OBJECT = INDEX_TABLE
END
