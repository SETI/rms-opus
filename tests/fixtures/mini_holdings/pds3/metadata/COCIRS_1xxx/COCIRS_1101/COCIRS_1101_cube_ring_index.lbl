    DATA_TYPE              = ASCII_INTEGER
    COLUMN_NUMBER          = 10
    START_BYTE             = 262
    BYTES                  = 3
    FORMAT                 = I2
    DESCRIPTION            = "Focal plane used."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
    NAME                   = TARGET_NAME
    DATA_TYPE              = CHARACTER
    COLUMN_NUMBER          = 11
    START_BYTE             = 267
    BYTES                  = 13
    FORMAT                 = A13
    DESCRIPTION            = "Target in the field of view."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
    NAME                   = SCET_START
    DATA_TYPE              = ASCII_INTEGER
    COLUMN_NUMBER          = 12
    START_BYTE             = 282
    BYTES                  = 12
    FORMAT                 = I11
    DESCRIPTION            = "Value of internal clock at the beginning of the
                             observation. Expressed in linux time (UT
                             seconds since Jan 1st 1970)."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
    NAME                   = SCET_END
    DATA_TYPE              = ASCII_INTEGER
    COLUMN_NUMBER          = 13
    START_BYTE             = 295
    BYTES                  = 12
    FORMAT                 = I11
    DESCRIPTION            = "Value of internal clock at the end of the
                             observation. Expressed in linux time (UT
                             seconds since Jan 1st 1970)."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
