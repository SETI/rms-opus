    NOT_APPLICABLE_CONSTANT= -200.
    COLUMN_NUMBER          = 18
    START_BYTE             = 384
    BYTES                  = 18
    FORMAT                 = "F11.7"
    DESCRIPTION            = "Beginning value of the planetographic
