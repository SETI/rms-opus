    DATA_TYPE              = CHARACTER
    COLUMN_NUMBER          = 9
    START_BYTE             = 236
    BYTES                  = 24
    FORMAT                 = A24
    DESCRIPTION            = "The name of the observation of which this
                             product is part. This name is derived from the
                             Predicted Events File (PEF)."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
