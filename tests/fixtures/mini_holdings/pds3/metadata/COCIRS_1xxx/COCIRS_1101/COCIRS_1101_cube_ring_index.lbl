PDS_VERSION_ID       = PDS3
RECORD_TYPE          = FIXED_LENGTH
RECORD_BYTES         = 859
FILE_RECORDS         = 3
DATA_SET_ID          = "CO-S-CIRS-2/3/4-TSDR-V3.2"
SPACECRAFT_NAME      = "CASSINI ORBITER"
