    NOT_APPLICABLE_CONSTANT= -200.
    COLUMN_NUMBER          = 17
    START_BYTE             = 365
    BYTES                  = 18
    FORMAT                 = "E12.5"
    DESCRIPTION            = "Ending value of the distance from the center of
