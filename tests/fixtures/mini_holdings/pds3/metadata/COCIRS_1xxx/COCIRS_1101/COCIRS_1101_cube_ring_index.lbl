    DATA_TYPE              = ASCII_REAL
    NOT_APPLICABLE_CONSTANT= -200.
    COLUMN_NUMBER          = 31
    START_BYTE             = 631
    BYTES                  = 18
    FORMAT                 = "F8.4"
    DESCRIPTION            = "Mean value of the local solar time at the
                             intersection of the boresight and the ring
                             plane in the primary's coordinate system. Unit
                             is fractional hours since midnight."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
    NAME                   = "CSS:MEAN_RING_BORESIGHT_LONGITUDE_ZPD"
    DATA_TYPE              = ASCII_REAL
    NOT_APPLICABLE_CONSTANT= -200.
    COLUMN_NUMBER          = 32
    START_BYTE             = 650
    BYTES                  = 18
    FORMAT                 = "F8.4"
    DESCRIPTION            = "Mean value of the longitude of the intersection
                             of the boresight and the ring plane at the ZPD
                             time. Longitudes are measured eastwards in an
                             inertial frame from the ascending node of the
                             intersection of the ring plane with J2000.
                             Unit is degrees east."
  END_OBJECT               = COLUMN

  OBJECT                   = COLUMN
    NAME                   = "CSS:MEAN_RING_BORESIGHT_RADIUS_ZPD"
    DATA_TYPE              = ASCII_REAL
    NOT_APPLICABLE_CONSTANT= -200.
    COLUMN_NUMBER          = 33
    START_BYTE             = 669
    BYTES                  = 18
    FORMAT                 = "F18.0"
