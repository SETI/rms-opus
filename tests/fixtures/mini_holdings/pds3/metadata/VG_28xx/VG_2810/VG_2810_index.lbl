  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MAXIMUM_RING_RADIUS
    COLUMN_NUMBER               = 15
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 275
    BYTES                       = 8
    FORMAT                      = "F8.1"
    UNIT                        = "km"
    DESCRIPTION                 = "The approximate outermost ring
radius found in this data product, in km."
  END_OBJECT                    = COLUMN

END_OBJECT                      = INDEX_TABLE
