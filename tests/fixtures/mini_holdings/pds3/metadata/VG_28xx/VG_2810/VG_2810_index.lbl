OBJECT                          = INDEX_TABLE
  INTERCHANGE_FORMAT            = ASCII
  ROWS                          = 2
  COLUMNS                       = 15
  ROW_BYTES                     = 284
  INDEX_TYPE                    = SINGLE
  DESCRIPTION                   = "This is a table of the files on
this archive volume. There is one record per data file on the disk.
The files indexed are those in the DATA directory and its
subdirectories."

  OBJECT                        = COLUMN
    NAME                        = VOLUME_ID
    COLUMN_NUMBER               = 1
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 2
    BYTES                       = 7
    FORMAT                      = A7
    DESCRIPTION                 = "The unique identifier for the PDS volume."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = FILE_SPECIFICATION_NAME
    COLUMN_NUMBER               = 2
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 12
    BYTES                       = 54
    FORMAT                      = A54
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Name and directory path of the PDS
label file describing this particular file."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = PRODUCT_ID
    COLUMN_NUMBER               = 3
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 69
    BYTES                       = 23
    FORMAT                      = A23
    UNIT                        = 'N/A'
    DESCRIPTION                 = "The product ID associated with the
given file. This is typically the file name."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = PRODUCT_TYPE
    COLUMN_NUMBER               = 4
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 95
    BYTES                       = 23
    FORMAT                      = A23
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Product type of a given data file.
In this data set, possible values are COMPRESSED_IMAGE,
DECOMPRESS_RAW_IMAGE, DECOMPRESSED_RAW_TIFF, CLEANED_IMAGE,
GEOMED_CALIBRATED_IMAGE, GEOMED_CALIBRATED_TIFF, ANNOTATED_TIFF,
IMAGE_SCAN, and RING_PROFILE."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = OBJECT_TYPE
    COLUMN_NUMBER               = 5
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 121
    BYTES                       = 8
    FORMAT                      = A8
    UNIT                        = 'N/A'
    DESCRIPTION                 = "The PDS object class of the major
data product in the associated file. Possible values in this data set
are DOCUMENT, IMAGE, and SERIES."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = INTERCHANGE_FORMAT
    COLUMN_NUMBER               = 6
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 132
    BYTES                       = 6
    FORMAT                      = A6
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Interchange format for the file.
Possible values are ASCII and BINARY."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPACECRAFT_NAME
    COLUMN_NUMBER               = 7
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 141
    BYTES                       = 9
    FORMAT                      = A9
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Name of the spacecraft for the data
in the given file. Possible values are 'VOYAGER 1' and 'VOYAGER 2'."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = TARGET_NAME
    COLUMN_NUMBER               = 8
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 153
    BYTES                       = 7
    FORMAT                      = A7
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Name of the target for the data in
the given file. In this data set the value is always 'S RINGS'."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = START_TIME
    COLUMN_NUMBER               = 9
    DATA_TYPE                   = TIME
    START_BYTE                  = 163
    BYTES                       = 23
    FORMAT                      = A23
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Observation start time associated
with the data in the given file. Given in PDS date/time format
('yyyy-mm-ddThh:mm:ss.sss')."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = STOP_TIME
    COLUMN_NUMBER               = 10
    DATA_TYPE                   = TIME
    START_BYTE                  = 189
    BYTES                       = 23
    FORMAT                      = A23
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Observation stop time associated
with the data in the given file. Given in PDS date/time format
('yyyy-mm-ddThh:mm:ss.sss')."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPACECRAFT_CLOCK_START_COUNT
    COLUMN_NUMBER               = 11
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 215
    BYTES                       = 12
    FORMAT                      = A12
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Voyager FDS ('Flight Data System')
count associated with the beginning of this file. The field format is
'hhhhh:mm:sss', specifying the FDS 'hours', 'minutes' and 'seconds'.
There are 60 FDS minutes (numbered 0-59) in an FDS hour and 800 FDS
seconds (numbered 1-800) in an FDS minute. An FDS hour equals 48 true
minutes; an FDS minute equals 48 true seconds; an FDS second equals
0.06 true seconds."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPACECRAFT_CLOCK_STOP_COUNT
    COLUMN_NUMBER               = 12
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 230
    BYTES                       = 12
    FORMAT                      = A12
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Voyager FDS ('Flight Data System')
count associated with the beginning of this file. The field format is
'hhhhh:mm:sss', specifying the FDS 'hours', 'minutes' and 'seconds'.
There are 60 FDS minutes (numbered 0-59) in an FDS hour and 800 FDS
seconds (numbered 1-800) in an FDS minute. An FDS hour equals 48 true
minutes; an FDS minute equals 48 true seconds; an FDS second equals
0.06 true seconds."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = RING_OBSERVATION_ID
    COLUMN_NUMBER               = 13
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 245
    BYTES                       = 19
    FORMAT                      = A19
    UNIT                        = 'N/A'
    DESCRIPTION                 = "An identifier used by the Rings Node
catalog to group related data products. In this data set, the possible
values are 'S/PROF/VG1/ISS/0001' for products related to the Voyager 1
profile and 'S/PROF/VG2/ISS/0001' for products related to the Voyager
2 profile."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MINIMUM_RING_RADIUS
    COLUMN_NUMBER               = 14
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 266
    BYTES                       = 8
    FORMAT                      = "F8.1"
    UNIT                        = "km"
    DESCRIPTION                 = "The approximate innermost ring
