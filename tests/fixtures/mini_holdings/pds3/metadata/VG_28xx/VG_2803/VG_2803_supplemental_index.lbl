    FORMAT                      = "F7.3"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The maximum value of the inertial ring
longitude of the intercept point. Longitudes are measured relative to the
ascending node of the ring plane on the Earth's J2000 equator."
  END_OBJECT                    = COLUMN

