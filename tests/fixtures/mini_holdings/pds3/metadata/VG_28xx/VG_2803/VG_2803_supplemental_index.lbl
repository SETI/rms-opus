  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MAXIMUM_RADIAL_RESOLUTION
    COLUMN_NUMBER               = 20
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 347
    BYTES                       = 7
    FORMAT                      = "F7.3"
    UNIT                        = "km"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The coarsest resolution in the data set, in
