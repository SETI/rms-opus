OBJECT                          = INDEX_TABLE
  INTERCHANGE_FORMAT            = ASCII
  ROWS                          = 20
  COLUMNS                       = 31
  ROW_BYTES                     = 453
  INDEX_TYPE                    = SINGLE
  DESCRIPTION                   = "This is a supplemental table of information
extracted from label files on this archive volume. There is one record per
label file in the volume. The files indexed are those in the CALIB, EASYDATA,
EDITDATA, GEOMETRY, IMAGES, NOISDATA, LOWDATA, SORCDATA, SPICE, TRAJECT, and
VECTORS directories."

  OBJECT                        = COLUMN
    NAME                        = VOLUME_ID
    COLUMN_NUMBER               = 1
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 2
    BYTES                       = 7
    FORMAT                      = A7
  DESCRIPTION                   = "Identifier of the volume in which the data
cube resides."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = FILE_SPECIFICATION_NAME
    COLUMN_NUMBER               = 2
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 12
    BYTES                       = 54
    FORMAT                      = A54
    DESCRIPTION                 = "Name and directory path of the PDS label
file describing this particular file."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = DATA_SET_ID
    COLUMN_NUMBER               = 3
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 69
    BYTES                       = 33
    FORMAT                      = A33
    DESCRIPTION                 = "The product ID associated with the
given file. This is typically the file name, sometimes with a
directory name prepended to make it unique."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = PRODUCT_CREATION_TIME
    COLUMN_NUMBER               = 4
    DATA_TYPE                   = TIME
    START_BYTE                  = 105
    BYTES                       = 19
    FORMAT                      = A19
    DESCRIPTION                 = "Time of creation of this cube on the
