    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 411
    BYTES                       = 9
    FORMAT                      = A9
    NOT_APPLICABLE_CONSTANT     = "N/A"
    DESCRIPTION                 = "The host (spacecraft or Earth base) where
