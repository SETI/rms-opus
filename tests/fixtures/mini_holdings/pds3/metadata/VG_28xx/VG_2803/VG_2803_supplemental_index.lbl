  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SIGNAL_SOURCE_NAME_2
    COLUMN_NUMBER               = 30
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 435
    BYTES                       = 9
    FORMAT                      = A9
    NOT_APPLICABLE_CONSTANT     = "N/A"
    DESCRIPTION                 = "If this product is relevant to photons from
