    COLUMN_NUMBER               = 9
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 168
    BYTES                       = 6
    FORMAT                      = A6
    DESCRIPTION                 = "The wavelength band at which the
occultation was observed. If two or more wavelength bans were observed, this
is the first."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = WAVELENGTH_BAND_2
    COLUMN_NUMBER               = 10
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 177
    BYTES                       = 6
    FORMAT                      = A6
    NOT_APPLICABLE_CONSTANT     = "N/A"
    DESCRIPTION                 = "A second wavelength band at which the
occultation was observed. If only one band was used, this value is 'N/A'."
