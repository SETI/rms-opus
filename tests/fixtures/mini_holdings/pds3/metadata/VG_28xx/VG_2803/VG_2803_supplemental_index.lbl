  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MAXIMUM_PHASE_ANGLE
    COLUMN_NUMBER               = 25
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 387
    BYTES                       = 6
    FORMAT                      = "F6.2"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The maximum value of the phase angle,
