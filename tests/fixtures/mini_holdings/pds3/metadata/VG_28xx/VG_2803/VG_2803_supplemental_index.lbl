  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = TEMPORAL_SAMPLING_INTERVAL
    COLUMN_NUMBER               = 31
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 446
    BYTES                       = 6
    FORMAT                      = "F6.2"
    NOT_APPLICABLE_CONSTANT     = -99.
