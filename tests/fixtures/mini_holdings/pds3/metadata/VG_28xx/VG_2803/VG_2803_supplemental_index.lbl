  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = OCCULTATION_TYPE
    COLUMN_NUMBER               = 7
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 150
    BYTES                       = 11
    FORMAT                      = A11
    DESCRIPTION                 = "The type of occultation, 'STELLAR',
'RADIO', or 'SOLAR'. Alternatively, 'REFLECTANCE' indicates that this is a
radial profile of ring reflectance values, rather than data from an actual
occultation."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = PLANETARY_OCCULTATION_FLAG
    COLUMN_NUMBER               = 8
    DATA_TYPE                   = CHARACTER
    START_BYTE                  = 164
    BYTES                       = 1
    FORMAT                      = A1
    DESCRIPTION                 = "'Y' if this occultation profile intersepts
the central planet; 'N' otherwise."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
