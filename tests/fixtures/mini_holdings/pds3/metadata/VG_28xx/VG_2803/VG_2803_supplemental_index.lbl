  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = INCIDENCE_ANGLE
    COLUMN_NUMBER               = 21
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 355
    BYTES                       = 10
    FORMAT                      = "F10.6"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The angle between the ring plane normal and
the direction to the source of illumination, be it a star, the Sun, or radio
transmissions from a spacecraft."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MINIMUM_EMISSION_ANGLE
    COLUMN_NUMBER               = 22
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 366
    BYTES                       = 6
    FORMAT                      = "F6.2"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The minimum value of the emission angle,
defined as the angle between the ring plane normal on the illuminated face,
and the direction to the detector. Values > 90 correspond to views of the
ring's unlit face. For occultations, this is 180 minus the incidence angle."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MAXIMUM_EMISSION_ANGLE
    COLUMN_NUMBER               = 23
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 373
    BYTES                       = 6
    FORMAT                      = "F6.2"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The maximum value of the emission angle,
defined as the angle between the ring plane normal on the illuminated face,
and the direction to the detector. Values > 90 correspond to views of the
ring's unlit face. For occultations, this is 180 minus the incidence angle."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MINIMUM_PHASE_ANGLE
    COLUMN_NUMBER               = 24
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 380
    BYTES                       = 6
    FORMAT                      = "F6.2"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The minimum value of the phase angle,
defined as the angle between the direction to the source and the direction to
