    COLUMN_NUMBER               = 18
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 326
    BYTES                       = 12
    FORMAT                      = "F12.5"
    UNIT                        = "km"
    NOT_APPLICABLE_CONSTANT     = -99.
