  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MINIMUM_RING_LONGITUDE_WRT_NODE
    COLUMN_NUMBER               = 26
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 394
    BYTES                       = 7
    FORMAT                      = "F7.3"
    UNIT                        = "deg"
    NOT_APPLICABLE_CONSTANT     = -99.
    DESCRIPTION                 = "The minimum value of the inertial ring
